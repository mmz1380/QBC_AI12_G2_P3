# Copy this file to `.env` and fill in whatever keys you have. `.env` is
# git-ignored -- never commit real keys. Every value here is optional; the
# project runs fully $0 with none of them set (RUN_MODE auto-falls-back to
# "local", and the assistant always has the $0 extractive fallback tier).
#
# If you set GROQ_API_KEY or PAID_API_KEY (and don't explicitly set
# DIGIKALA_RUN_MODE yourself), config.py auto-switches RUN_MODE to
# "hosted_auto", which tries Groq first, then the paid gateway -- see
# src/digikala/config.py HOSTED_PROVIDER_ORDER.

# ---- hosted LLM providers (pick whichever you have) ----
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b          # default; override if Groq retires a model
# By default Groq's free tier does NOT count against the $5 budget (its
# estimated list cost is still reported). Set to 1 to treat it as billed.
# DIGIKALA_GROQ_BILLED=0

PAID_API_KEY=
# PAID_BASE_URL=https://api.openai.com/v1
# PAID_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=

# ---- explicit overrides (optional; auto-detected otherwise) ----
# DIGIKALA_RUN_MODE=hosted_auto          # local | free | paid | hosted_auto | extractive
# DIGIKALA_JUDGE_MODE=local              # local | free | paid | hosted_auto | none
# DIGIKALA_SAMPLE=full                   # or an integer, e.g. 200000
# DIGIKALA_FREE_PROVIDER=groq            # which provider "free" mode uses
# DIGIKALA_EMBED_DEVICE=cuda             # cuda | cpu

# ---- HuggingFace (optional, avoids rate limits on model/dataset downloads) ----
HF_TOKEN=
